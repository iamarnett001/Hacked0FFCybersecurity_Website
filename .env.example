# Optional. Without these, the contact form still validates and shows success,
# but inquiries are only logged on the server — they are not emailed.
#
# Create a Resend account, verify your domain, then fill these in locally
# and in Vercel environment variables.

RESEND_API_KEY=
CONTACT_FROM_EMAIL="Website <noreply@sovereigntycyber.com>"
CONTACT_TO_EMAIL=info@sovereigntycyber.com
